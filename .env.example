# Escolha auto para tentar apenas os provedores que têm chave configurada.
AI_PROVIDER=auto
AI_PROVIDER_ORDER=gemini,openai,anthropic

# Configure uma ou mais chaves. Nunca envie o arquivo .env para o GitHub.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos atuais sugeridos em agosto de 2026. Você pode trocar sem alterar o código.
GEMINI_MODEL=gemini-3.6-flash
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
ANTHROPIC_MODEL=claude-sonnet-5
MAX_AI_OUTPUT_TOKENS=24000

# Pastas. Caminhos relativos ao projeto funcionam em qualquer Mac.
DATA_DIR=./data
LOCAL_MEDIA_DIR=./data/inbox

# Processamento local.
MAX_FRAMES=12
MAX_UPLOAD_MB=500
HOOK_SECONDS=3
WHISPER_MODEL=small
TRANSCRIPTION_LANGUAGE=pt
ENABLE_TRANSCRIPTION=true
ENABLE_PUBLIC_COLLECTION=true
COMMAND_TIMEOUT_SECONDS=180

# Leitura automática de links públicos do Instagram pertencentes a outras contas.
# Necessária no Streamlit Cloud porque o Instagram costuma bloquear IPs de nuvem com HTTP 429.
APIFY_API_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
MAX_PUBLIC_COMMENTS=50

# Acesso oficial a Insights completos de uma conta profissional administrada por você.
ENABLE_INSTAGRAM_GRAPH=true
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v25.0
MAX_INSTAGRAM_COMMENTS=300
INSTAGRAM_HISTORY_LIMIT=20

# Fallback local opcional: cookies exportados pelo próprio navegador.
COOKIES_FILE=
