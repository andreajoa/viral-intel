# Viral Intel 5.1 — configuração de referência
AI_PROVIDER=auto
AI_PROVIDER_ORDER=gemini,openai,anthropic

# Configure uma ou mais chaves. Nunca envie o arquivo .env para o GitHub.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos recomendados em agosto de 2026.
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
ANTHROPIC_MODEL=claude-sonnet-5
MAX_AI_OUTPUT_TOKENS=24000

# Inteligência semântica de comentários.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
ENABLE_SEMANTIC_COMMENTS=true
SEMANTIC_COMMENT_LIMIT=40
SEMANTIC_CLUSTER_THRESHOLD=0.78

# Pastas e memória longitudinal local.
DATA_DIR=./data
LOCAL_MEDIA_DIR=./data/inbox
EPHEMERAL_MODE=false
ENABLE_PERSISTENCE=true
INTELLIGENCE_DB=./data/viral_intel.sqlite3
CONTENT_TWIN_LIMIT=8
CONTENT_TWIN_MIN_SCORE=0.35

# Memória durável na nuvem. Em Streamlit Cloud, use Worker + D1.
CLOUDFLARE_MEMORY_URL=
CLOUDFLARE_MEMORY_SECRET=
CLOUDFLARE_MEMORY_TIMEOUT_SECONDS=20

# Processamento de mídia.
MAX_FRAMES=16
MAX_UPLOAD_MB=500
HOOK_SECONDS=3
WHISPER_MODEL=small
TRANSCRIPTION_LANGUAGE=pt
ENABLE_TRANSCRIPTION=true
ENABLE_NATIVE_VIDEO_AI=true
NATIVE_VIDEO_MAX_MB=200
NATIVE_VIDEO_POLL_SECONDS=2
NATIVE_VIDEO_TIMEOUT_SECONDS=120
ENABLE_PUBLIC_COLLECTION=true
ENABLE_INSTAGRAM_EMBED=true
COMMAND_TIMEOUT_SECONDS=180

# Integração opcional para ampliar a leitura de posts públicos de outras contas.
APIFY_API_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
MAX_PUBLIC_COMMENTS=100

# Instagram oficial — conta profissional administrada por você.
ENABLE_INSTAGRAM_GRAPH=true
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v25.0
MAX_INSTAGRAM_COMMENTS=500
INSTAGRAM_HISTORY_LIMIT=50
INSTAGRAM_MAX_RETRIES=3
INSTAGRAM_BACKOFF_SECONDS=1

# TikTok Display API autorizada pelo criador.
TIKTOK_ACCESS_TOKEN=
TIKTOK_HISTORY_LIMIT=20

# YouTube Data + Analytics APIs com OAuth do proprietário.
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_HISTORY_LIMIT=25

# Fallback local opcional: cookies exportados pelo próprio navegador.
COOKIES_FILE=
