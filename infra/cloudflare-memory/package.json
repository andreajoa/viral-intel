{
  "name": "viral-intel-cloudflare-memory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "check": "npm run cf-typegen && tsc --noEmit && wrangler deploy --dry-run --outdir=.wrangler-dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply viral-intel-memory --local",
    "db:migrate:remote": "wrangler d1 migrations apply viral-intel-memory --remote"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "wrangler": "^4.40.0"
  }
}
