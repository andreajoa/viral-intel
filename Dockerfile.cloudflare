FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/tmp/viralintel-home \
    DATA_DIR=/tmp/viral-intel-data \
    LOCAL_MEDIA_DIR=/tmp/viral-intel-data/inbox \
    VIRAL_INTEL_EXECUTION=cloudflare \
    ENABLE_TRANSCRIPTION=false \
    EPHEMERAL_MODE=true \
    ENABLE_PERSISTENCE=true \
    MAX_UPLOAD_MB=100 \
    COMMAND_TIMEOUT_SECONDS=120

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY cloud/requirements.txt /tmp/requirements.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r /tmp/requirements.txt \
    && python -m pip check

COPY . /app

RUN groupadd --gid 10001 viralintel \
    && useradd --uid 10001 --gid 10001 --home-dir /tmp/viralintel-home --create-home --shell /usr/sbin/nologin viralintel \
    && mkdir -p /tmp/viral-intel-data/inbox /tmp/viral-intel-data/tmp /tmp/viral-intel-data/exports /tmp/viral-intel-data/jobs /tmp/viral-intel-data/profiles \
    && chown -R viralintel:viralintel /tmp/viral-intel-data /tmp/viralintel-home

USER viralintel
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:8080/viral-intel/_stcore/health >/dev/null || exit 1

CMD ["streamlit", "run", "cloud/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8080", "--server.headless=true", "--server.baseUrlPath=viral-intel", "--server.maxUploadSize=100", "--server.maxMessageSize=110", "--browser.gatherUsageStats=false"]
