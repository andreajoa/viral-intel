{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "viral-intel-app-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "viral-intel-staging.andre-almeida.online",
      "custom_domain": true
    }
  ],
  "vars": {
    "VIRAL_INTEL_BASIC_USER": "andre",
    "STREAMLIT_ORIGIN": "https://viral-intel-xcpaef9v2esxkyz5ifgvke.streamlit.app"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
